{
  "name": "@kervan/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --packages=external --alias:@kervan/shared=../../packages/shared/src/index.ts",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@kervan/shared": "*",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13"
  }
}
